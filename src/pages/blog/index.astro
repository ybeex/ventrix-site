---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getCollection } from 'astro:content';
import { fmt, readingTime, slugify } from '../../lib';
const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="Blog" description="Practical guides on tool rooms, workshop stock, counts and inventory habits that stick.">
  <section class="hero"><div class="wrap"><span class="eyebrow">Blog</span><h1>Run a tighter store.</h1><p class="lede">Practical guides for Ventrixs, workshop managers and anyone who lends tools out.</p>
    <div class="tags" style="margin-top:18px">{tags.map((t) => <a class="badge" href={`/blog/tags/${slugify(t)}`}>{t}</a>)}</div></div></section>
  <section class="sec tight"><div class="wrap grid g2">
    {posts.map((p) => <a class="card glass post-card" href={`/blog/${p.id}`}><div class="tags">{p.data.tags.map((t) => <span class="badge">{t}</span>)}</div><h3>{p.data.title}</h3><p>{p.data.description}</p><span class="muted" style="font-size:14px">{fmt(p.data.date)} · {readingTime(p.body)} min read</span></a>)}
  </div></section>
  <Cta />
</Base>
