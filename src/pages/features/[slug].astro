---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { features } from '../../data/features';
import { SITE } from '../../config';
export function getStaticPaths() { return features.map((f) => ({ params: { slug: f.slug }, props: { f } })); }
const { f } = Astro.props;
const others = features.filter((x) => x.slug !== f.slug).slice(0, 3);
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: f.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base title={f.name} description={f.short + ' ' + f.intro.split('.')[0] + '.'} jsonLd={ld}>
  <section class="hero"><div class="wrap hero-grid">
    <div><span class="eyebrow"><a href="/features" style="text-decoration:none">Features</a> / {f.name}</span><h1 style="font-size:clamp(42px,6.5vw,76px)">{f.headline}</h1><p class="lede">{f.intro}</p>
      <div class="cta-row"><a class="btn primary" href={SITE.signupUrl}>Get started</a><a class="btn" href="/pricing">Pricing</a></div></div>
    <Shot name={f.shot} alt={f.shotAlt} eager />
  </div></section>
  <section class="sec"><div class="wrap split">
    <div><h2>What you get</h2><ul class="checks">{f.points.map((p) => <li>{p}</li>)}</ul></div>
    <div class="card glass"><h3>How it works</h3><div class="steps">{f.how.map((s) => <div><p style="padding-top:8px">{s}</p></div>)}</div></div>
  </div></section>
  <section class="sec"><div class="wrap narrow"><h2>Common questions</h2>{f.faq.map(([q, a]) => <details name="faq"><summary>{q}</summary><p>{a}</p></details>)}</div></section>
  <section class="sec"><div class="wrap"><h2>More features</h2><div class="grid g3">{others.map((o) => <a class="card glass link" href={`/features/${o.slug}`}><div class="ic"><Icon name={o.icon as any} /></div><h3>{o.name}</h3><p>{o.short}</p></a>)}</div></div></section>
  <Cta />
</Base>
