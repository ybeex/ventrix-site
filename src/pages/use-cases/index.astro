---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { useCases } from '../../data/usecases';
---
<Base title="Use cases" description="How tool rooms, workshops, schools and contractors use Ventrix to track tools, stock and equipment.">
  <section class="hero"><div class="wrap"><span class="eyebrow">Use cases</span><h1>If it leaves the shelf, track it.</h1><p class="lede">Different places, same problem. Here is how four kinds of team use Ventrix.</p></div></section>
  <section class="sec tight"><div class="wrap grid g2">
    {useCases.map((u) => <a class="card glass link" href={`/use-cases/${u.slug}`}><div class="ic"><Icon name={u.icon as any} /></div><h3>{u.name}</h3><p>{u.short}</p><span class="more">Read more →</span></a>)}
  </div></section>
  <Cta />
</Base>
